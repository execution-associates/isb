{
  "name": "@execution-associates/isb-alchemy",
  "version": "4.6.0",
  "description": "Alchemy provider for isb: deploy apps, stacks and secrets to an isb host as infrastructure-as-code",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/execution-associates/isb.git",
    "directory": "sdk/alchemy"
  },
  "homepage": "https://github.com/execution-associates/isb/tree/main/sdk/alchemy#readme",
  "keywords": ["alchemy", "isb", "incus", "infrastructure-as-code", "effect", "paas"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "engines": {
    "bun": ">=1.2",
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test examples",
    "format": "biome format --write src test examples",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "alchemy": ">=2.0.0-beta.87",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@alchemy.run/test": "2.0.0-beta.87",
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.2.0",
    "alchemy": "2.0.0-beta.87",
    "effect": "^4.1.4",
    "typescript": "^5.9.0"
  }
}

{
  "components": {
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "isb_session",
        "type": "apiKey"
      },
      "token": {
        "description": "An API token (isb token create)",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "isb",
    "version": "0.7.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/tools/events": {
      "post": {
        "description": "What happened, newest last: deploys, rollouts, health changes, restarts, failures. Pass the last `seq` you saw as `since` to get only newer ones; `wait` (seconds, at most 30) holds the call until one arrives.",
        "operationId": "events",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "limit": {
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "org": {
                    "description": "The org to act in (default: default).",
                    "type": "string"
                  },
                  "since": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "wait": {
                    "maximum": 30,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "result": {}
                  },
                  "type": "object"
                }
              }
            },
            "description": "The tool's result"
          },
          "default": {
            "description": "An error: {error, message, data}"
          }
        },
        "summary": "Events"
      }
    },
    "/api/v1/tools/overview": {
      "post": {
        "description": "Everything a dashboard shows in one call: the host's CPU and memory (with history), every stack in detail (as stack_status), the sandboxes (status, IP, CPU, memory), and the latest event number for the events tool.",
        "operationId": "overview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "org": {
                    "description": "The org to act in (default: default).",
                    "type": "string"
                  }
                },
                "required": [],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "result": {}
                  },
                  "type": "object"
                }
              }
            },
            "description": "The tool's result"
          },
          "default": {
            "description": "An error: {error, message, data}"
          }
        },
        "summary": "Overview"
      }
    },
    "/api/v1/tools/sandbox_create": {
      "post": {
        "description": "Create (or reconcile) one sandbox: an incus container or VM to run code in isolation. `spec` is one compose service (docs/spec.md) with container_name set, as an object or YAML text. Remote callers' sandboxes are labelled with their identity, and only managed sandboxes are reachable remotely.",
        "operationId": "sandbox_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "org": {
                    "description": "The org to act in (default: default).",
                    "type": "string"
                  },
                  "spec": {
                    "description": "The service spec: an object, or YAML text."
                  },
                  "wait_ready": {
                    "description": "Run readiness checks (default true).",
                    "type": "boolean"
                  }
                },
                "required": [
                  "spec"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "result": {}
                  },
                  "type": "object"
                }
              }
            },
            "description": "The tool's result"
          },
          "default": {
            "description": "An error: {error, message, data}"
          }
        },
        "summary": "Create a sandbox"
      }
    },
    "/api/v1/tools/sandbox_exec": {
      "post": {
        "description": "Run argv in a sandbox (no shell unless you run one: [\"sh\", \"-c\", \"...\"]) and return its exit code and output (each stream capped at 256 KiB, keeping the end). Uses the sandbox's user and working_dir unless given.",
        "operationId": "sandbox_exec",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "argv": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "env": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "name": {
                    "type": "string"
                  },
                  "org": {
                    "description": "The org to act in (default: default).",
                    "type": "string"
                  },
                  "stdin": {
                    "description": "Text fed to the command's stdin.",
                    "type": "string"
                  },
                  "timeout": {
                    "description": "Kill after this long, e.g. 30s (default 10m).",
                    "type": "string"
                  },
                  "user": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "argv"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "result": {}
                  },
                  "type": "object"
                }
              }
            },
            "description": "The tool's result"
          },
          "default": {
            "description": "An error: {error, message, data}"
          }
        },
        "summary": "Run a command in a sandbox"
      }
    },

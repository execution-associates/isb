    "/api/v1/tools/stack_deploy": {
      "post": {
        "description": "Deploy or update a stack from a docker-compose-style file (isb's format: docs/spec.md). Each service runs `deploy.replicas` incus instances, supervised inside their guests so they survive restarts of this server and of the host. Published ports are load-balanced over healthy replicas. A changed service is rolled out per `deploy.update_config` (stop-first by default; `order: start-first` for no downtime). Returns the change per service; pass wait=true to block until the rollout settles.",
        "operationId": "stack_deploy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "base_dir": {
                    "description": "Host directory relative bind paths resolve against. Remote callers: must be under a --bind-root.",
                    "type": "string"
                  },
                  "compose": {
                    "description": "The compose file, as YAML text. ${VAR} is filled from `vars` only.",
                    "type": "string"
                  },
                  "dry_run": {
                    "description": "Only report what would change.",
                    "type": "boolean"
                  },
                  "name": {
                    "description": "Stack name: [a-z0-9-], starts with a letter, at most 30 characters.",
                    "type": "string"
                  },
                  "org": {
                    "description": "The org to act in (default: default).",
                    "type": "string"
                  },
                  "secrets": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Values of `file:`/`environment:` secrets by top-level secret name. They are stored in the org's store as <stack>_<name>; `external`, `age` and `driver` secrets need none.",
                    "type": "object"
                  },
                  "timeout": {
                    "description": "How long wait may take, e.g. 5m (default 10m).",
                    "type": "string"
                  },
                  "vars": {
                    "additionalProperties": {
                      "type": "string"
                    },

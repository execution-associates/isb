                    "type": "object"
                  },
                  "name": {
                    "description": "Secret name: 1-128 of [A-Za-z0-9_.-], not starting with '.'.",
                    "type": "string"
                  },
                  "org": {
                    "description": "The org (default: default).",
                    "type": "string"
                  },
                  "value": {
                    "description": "The value, base64.",
                    "type": "string"
